! Historical: ~/.Xresources from the Manjaro i3 workstation preserved at
! https://github.com/j3w1/1w3j (config/Xresources). Trimmed to the parts this desktop
! re-creates; nothing here is read by the site at runtime.

Xft.dpi:       96
Xft.antialias: true
Xft.hinting:   true
Xft.rgba:      rgb
Xft.autohint:  false
Xft.hintstyle: hintslight
Xft.lcdfilter: lcddefault
*background:            #0C0909
*foreground:            #E99499
*cursorColor:           #E99499
*color0:                #0C0909
*color8:                #7D1310
*color1:                #C81A1A
*color9:                #AB1612
*color2:                #BD787D
*color10:               #AD2721
*color3:                #D4868B
*color11:               #B37175
*color4:                #8C1212
*color12:               #871F19
*color5:                #F73f35
*color13:               #E82132
*color6:                #9E474A
*color14:               #E0292F
*color7:                #FFA2A7
*color15:               #A3676B
#define pixel_size    13
*font:           xft:Source Code Pro for Powerline:medium:pixelsize=pixel_size:autohint=true:antialias=true,xft:TerminessTTFNerdFontMono:medium:pixelsize=pixel_size:autohint=true:antialias=true,xft:DejaVuSansMono Nerd Font Mono:medium:pixelsize=pixel_size:autohint=true:antialias=true
URxvt.depth:                      32
URxvt.background:                 [100]#0C0909
URxvt*scrollBar:                  false
URxvt*mouseWheelScrollPage:       false
URxvt*cursorBlink:                true
URxvt*background:                 #0C0909
URxvt*foreground:                 #e99499
URxvt*saveLines:                  5000
URxvt.iso14755:                   false
URxvt.keysym.Shift-Control-V:     eval:paste_clipboard
URxvt.keysym.Shift-Control-C:     eval:selection_to_clipboard
URxvt.keysym.Control-Left:        \033[1;5D
URxvt.keysym.Shift-Control-Left:  \033[1;6D
URxvt.keysym.Control-Right:       \033[1;5C
URxvt.keysym.Shift-Control-Right: \033[1;6C
URxvt.keysym.Control-Up:          \033[1;5A
URxvt.keysym.Shift-Control-Up:    \033[1;6A
URxvt.keysym.Control-Down:        \033[1;5B
URxvt.keysym.Shift-Control-Down:  \033[1;6B
 URxvt*letterSpace:                 -1
